# Copy to .env.local and fill what you need. Nothing here is committed.

# Required for anything database-backed. Neon pooled connection string.
DATABASE_URL=postgresql://user:password@host.neon.tech/portfolio?sslmode=require
# Optional direct (non-pooled) connection, used by the migration runner.
DATABASE_URL_DIRECT=

# Required for admin sessions. Generate with: openssl rand -base64 48
SESSION_SECRET=

# Optional: media uploads. Without a token the local disk driver is used.
STORAGE_DRIVER=local
BLOB_READ_WRITE_TOKEN=

# Optional: transactional email for inquiry notifications (Resend).
RESEND_API_KEY=
NOTIFICATION_EMAIL_FROM=
NOTIFICATION_EMAIL_TO=

# Optional: AI assistant. The assistant stays disabled until all three are set.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Optional: absolute site URL used outside a request scope.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
