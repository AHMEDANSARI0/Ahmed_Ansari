import { revalidatePath, revalidateTag } from "next/cache";
import { CONFIG_TAGS } from "@/lib/services/settings";

const PROFILE = "max";

export function bumpTags(...tags: string[]) {
  const unique = new Set<string>([CONFIG_TAGS.content, ...tags]);

  for (const tag of unique) {
    try {
      revalidateTag(tag, PROFILE);
    } catch {
      // outside a request scope the tag call is a no-op
    }
  }

  // Public routes are statically prerendered, so the route cache needs an
  // explicit purge as well; tag invalidation alone leaves the HTML stale.
  for (const path of ["/", "/work", "/sitemap.xml"]) {
    try {
      revalidatePath(path);
    } catch {
      // same
    }
  }
}
